    "preparer:pinball": "esbuild tools/preparer.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/preparer.mjs --log-level=warning && node dist/preparer.mjs",
    "chercher-verrou:pinball": "esbuild tools/chercher-verrou.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/chercher-verrou.mjs --log-level=warning && node dist/chercher-verrou.mjs",
