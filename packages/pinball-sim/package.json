{
  "name": "@cdj/pinball-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "@cdj/core": "*"
  },
  "scripts": {
