{
  "name": "@cdj/jump-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@cdj/core": "*"
  },
  "scripts": {
    "solve:modules": "esbuild tools/solve-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/solve-modules.mjs --log-level=warning && node dist/solve-modules.mjs",
    "measure:modules": "esbuild tools/measure-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-modules.mjs --log-level=warning && esbuild tools/solve-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/solve-modules.mjs --log-level=warning && node dist/measure-modules.mjs",
    "measure:jump": "esbuild tools/measure-jump.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-jump.mjs --log-level=warning && node dist/measure-jump.mjs",
    "voir:module": "esbuild tools/voir.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/voir.mjs --log-level=warning && node dist/voir.mjs",
    "measure:elan": "esbuild tools/measure-elan.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-elan.mjs --log-level=warning && node dist/measure-elan.mjs",
    "repos:modules": "esbuild tools/repos.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/repos.mjs --log-level=warning && node dist/repos.mjs",
    "etat:modules": "esbuild tools/etat.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/etat.mjs --log-level=warning && node dist/etat.mjs",
    "secours:jump": "esbuild tools/secours.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/secours.mjs --log-level=warning && node dist/secours.mjs"
  }
}
