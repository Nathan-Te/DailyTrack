{
  "name": "@cdj/jump-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "@cdj/core": "*"
  },
  "scripts": {
    "solve:modules": "esbuild tools/solve-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/solve-modules.mjs --log-level=warning && node dist/solve-modules.mjs",
    "measure:modules": "esbuild tools/measure-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-modules.mjs --log-level=warning && esbuild tools/solve-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/solve-modules.mjs --log-level=warning && node dist/measure-modules.mjs",
    "measure:jump": "esbuild tools/measure-jump.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-jump.mjs --log-level=warning && node dist/measure-jump.mjs",
    "rythme:modules": "esbuild tools/rythme.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/rythme.mjs --log-level=warning && node dist/rythme.mjs",
    "voir:module": "esbuild tools/voir.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/voir.mjs --log-level=warning && node dist/voir.mjs",
    "measure:elan": "esbuild tools/measure-elan.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-elan.mjs --log-level=warning && node dist/measure-elan.mjs",
    "repos:modules": "esbuild tools/repos.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/repos.mjs --log-level=warning && node dist/repos.mjs",
    "secours:modules": "esbuild tools/secours.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/secours.mjs --log-level=warning && node dist/secours.mjs",
    "phases:modules": "esbuild tools/phases.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/phases.mjs --log-level=warning && node dist/phases.mjs",
    "voies:modules": "esbuild tools/voies-modules.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/voies-modules.mjs --log-level=warning && node dist/voies-modules.mjs",
    "trace:module": "esbuild tools/trace.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/trace.mjs --log-level=warning && node dist/trace.mjs",
    "figes:jump": "esbuild tools/figes.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/figes.mjs --log-level=warning && node dist/figes.mjs",
    "variete:jump": "esbuild tools/variete.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/variete.mjs --log-level=warning && node dist/variete.mjs",
    "ponts:modules": "esbuild tools/ponts.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/ponts.mjs --log-level=warning && node dist/ponts.mjs",
    "etats:modules": "esbuild tools/etats.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/etats.mjs --log-level=warning && node dist/etats.mjs",
    "appuis:modules": "esbuild tools/appuis.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/appuis.mjs --log-level=warning && node dist/appuis.mjs",
    "lame:modules": "esbuild tools/lame.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/lame.mjs --log-level=warning && node dist/lame.mjs",
    "rebonds:modules": "esbuild tools/rebonds.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/rebonds.mjs --log-level=warning && node dist/rebonds.mjs"
  }
}
