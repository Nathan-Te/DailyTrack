{
  "name": "@cdj/blocks-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "@cdj/core": "*"
  },
  "scripts": {
    "figer:blocks": "esbuild tools/figer.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/figer.mjs --log-level=warning && node dist/figer.mjs",
    "golden:blocks": "esbuild tools/references.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/references.mjs --log-level=warning && node dist/references.mjs",
    "mesure:rampe": "esbuild tools/mesure-rampe.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mesure-rampe.mjs --log-level=warning && node dist/mesure-rampe.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./calendrier": "./src/calendrier.ts",
    "./glouton": "./src/glouton.ts"
  }
}
