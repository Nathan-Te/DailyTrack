{
  "name": "@cdj/blocks-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "@cdj/core": "*"
  },
  "scripts": {
    "figer:blocks": "esbuild tools/figer.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/figer.mjs --log-level=warning && node dist/figer.mjs",
    "golden:blocks": "esbuild tools/references.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/references.mjs --log-level=warning && node dist/references.mjs",
    "calibrer:medailles": "esbuild tools/calibrer-medailles.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/calibrer-medailles.mjs --log-level=warning && node dist/calibrer-medailles.mjs",
    "mesure:rampe": "esbuild tools/mesure-rampe.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mesure-rampe.mjs --log-level=warning && node dist/mesure-rampe.mjs",
    "mesure:repartition": "esbuild tools/mesure-repartition.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mesure-repartition.mjs --log-level=warning && node dist/mesure-repartition.mjs",
    "mesure:tirage": "esbuild tools/mesure-tirage.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mesure-tirage.mjs --log-level=warning && node dist/mesure-tirage.mjs",
    "courbe:medailles": "esbuild tools/courbe-medailles.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/courbe-medailles.mjs --log-level=warning && node dist/courbe-medailles.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./calendrier": "./src/calendrier.ts",
    "./glouton": "./src/glouton.ts",
    "./faible": "./src/faible.ts",
    "./diamant": "./src/diamant.ts",
    "./v1": "./src/v1.ts"
  }
}
