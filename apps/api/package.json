{
  "name": "@cdj/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:node": "node scripts/build-node.mjs",
    "start": "node dist/server.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "measure:generator": "esbuild scripts/measure-generator.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-generator.mjs && node dist/measure-generator.mjs",
    "measure:salon": "esbuild scripts/measure-salon.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-salon.mjs && NODE_NO_WARNINGS=1 node dist/measure-salon.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/smoke.mjs --log-level=warning && node dist/smoke.mjs",
    "measure:jump-api": "esbuild scripts/measure-jump.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-jump.mjs --log-level=warning && NODE_NO_WARNINGS=1 node dist/measure-jump.mjs",
    "measure:budget": "esbuild scripts/measure-budget.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-budget.mjs --log-level=warning && NODE_NO_WARNINGS=1 node dist/measure-budget.mjs",
    "history:seed": "esbuild scripts/history-seed.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/history-seed.mjs && node dist/history-seed.mjs",
    "pseudos:migrate": "esbuild scripts/pseudos-migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/pseudos-migrate.mjs --log-level=warning && NODE_NO_WARNINGS=1 node dist/pseudos-migrate.mjs",
    "jump:seed": "esbuild scripts/jump-seed.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/jump-seed.mjs --log-level=warning && NODE_NO_WARNINGS=1 node dist/jump-seed.mjs",
    "measure:platform": "esbuild scripts/measure-platform.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/measure-platform.mjs --log-level=warning && node dist/measure-platform.mjs"
  },
  "dependencies": {
    "@cdj/clock": "*",
    "@cdj/core": "*",
    "@cdj/jump-sim": "*",
    "@cdj/sim": "*",
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.147.0"
  }
}
