import { CIBLES_GENERATOR_VERSION, CIBLES_SIM_VERSION, TICKS_PAR_SECONDE, dailyCibles, formatScore, numeroCibles, scorePartage, type Contenu } from "@cdj/cibles-sim";
import type { DefinitionJeuParty } from "@cdj/kit/jeu/types";
import { nouvellePartieCibles } from "./scene";

// La définition du jeu Party de départ pour `brancherJeu` (lot PA1) : sa simulation, son rendu, son aide — ni thème, ni médailles, ni fantôme : le kit complète (`DefinitionJeuParty`). Tout le reste est le kit. **Moins de 100 lignes de glue** : c'est la mesure du lot K4f.
// Lot PA1c : ni les essais du témoin (`?debug&chargement|hud|bilan|dessins`, ils tournent sur « Cibles »), ni `variante.ts` : un jeu Party se classe au score.
/** Le contenu d'un jour : **sa graine et ce qu'on en tire** (`dailyCibles`) — un jeu Party n'a ni générateur de niveaux ni fichier de jour figé. */
const contenuDuJour = async (jour: number): Promise<Contenu> => dailyCibles(jour, CIBLES_GENERATOR_VERSION);

export const DEFINITION: DefinitionJeuParty<Contenu> = {
  ticksParSeconde: TICKS_PAR_SECONDE,
  versions: { simVersion: CIBLES_SIM_VERSION, generatorVersion: CIBLES_GENERATOR_VERSION },
  actions: [
    { id: "gauche", clavier: ["ArrowLeft", "KeyA"], manette: null },
    { id: "droite", clavier: ["ArrowRight", "KeyD"], manette: null },
    { id: "haut", clavier: ["ArrowUp", "KeyW"], manette: null },
    { id: "bas", clavier: ["ArrowDown", "KeyS"], manette: null },
    { id: "toucher", clavier: ["Space", "KeyX"], manette: "b0" },
  ],
  numero: numeroCibles,
  contenuDuJour,
  nouvellePartie: nouvellePartieCibles,
  formatScore,
  scorePartage,
  aide: ["aide.point1", "aide.point2", "aide.point3"],
};
