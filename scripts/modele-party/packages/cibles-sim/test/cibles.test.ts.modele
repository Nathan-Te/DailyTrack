import { readFileSync } from "node:fs";
import { describe, expect, it } from "vitest";
import { daysFromCivil, graineDuJour } from "@cdj/core";
import {
  CIBLES_GENERATOR_VERSION,
  COLONNES,
  COLONNES_CLASSEMENT,
  DUREE_TICKS,
  ErreurGenerateur,
  LIGNES,
  MAX_TOUCHES,
  NB_CASES,
  NB_CIBLES,
  Partie,
  caseAuPoint,
  dailyCibles,
  decoderRediffusion,
  empreinteContenu,
  encoderRediffusion,
  enregistrer,
  formatScore,
  jouer,
  joueurVif,
  rejouer,
  scoreDe,
  scoreParColonnes,
  tirerCibles,
} from "../src/index";

// Un jeu Party (lot PA1) : le « niveau » d'un jour est sa graine ; le jeu en tire ses cibles. Ce que vaut le tirage, la partie, son classement et la rediffusion. Lot PA1c : plus de `variante.ts` — un jeu Party se classe au score, ses règles sont dans `partie.ts`.
const J = daysFromCivil(2026, 11, 4);
const vif = (c: ReturnType<typeof dailyCibles>) => joueurVif(c, () => 12);

describe("le tirage du jour : la graine, rien d'autre", () => {
  it("est déterministe, change d'un jour à l'autre, et ne dépend que de la graine", () => {
    for (let j = J; j < J + 20; j++) {
      const a = dailyCibles(j);
      expect(empreinteContenu(a)).toBe(empreinteContenu(dailyCibles(j)));
      expect(a.graine).toBe(graineDuJour("cibles", j));
      expect(a.cibles).toEqual(tirerCibles(a.graine));
      expect(a.cibles).toHaveLength(NB_CIBLES);
    }
    expect(empreinteContenu(dailyCibles(J))).not.toBe(empreinteContenu(dailyCibles(J + 1)));
  });
  it("jamais deux fois la même case de suite, fenêtres disjointes et assez longues", () => {
    for (let j = J; j < J + 60; j++) {
      const { cibles } = dailyCibles(j);
      cibles.forEach((x, i) => {
        expect(x.c).toBeGreaterThanOrEqual(0);
        expect(x.c).toBeLessThan(NB_CASES);
        if (i > 0) {
          expect(x.c).not.toBe(cibles[i - 1]!.c);
          expect(x.d).toBeGreaterThanOrEqual(cibles[i - 1]!.f);
        }
        expect(x.f - x.d).toBeGreaterThan(20);
      });
    }
  });
  it("refuse une version inconnue du tirage", () => {
    expect(() => dailyCibles(J, 99)).toThrow(ErreurGenerateur);
    expect(CIBLES_GENERATOR_VERSION).toBe(1);
  });
});

describe("la partie", () => {
  it("compte une cible touchée dans sa fenêtre, ignore le reste", () => {
    const p = new Partie(dailyCibles(J));
    const x = p.contenu.cibles[0]!;
    while (p.tick < x.d - 1) p.avancer();
    expect(p.toucher(x.c)).toBe(false); // pas encore apparue
    p.avancer();
    expect(p.toucher((x.c + 1) % NB_CASES)).toBe(false); // mauvaise case
    expect(p.toucher(x.c)).toBe(true);
    expect(p.toucher(x.c)).toBe(false); // déjà touchée
    const r = p.resultat();
    expect({ touches: r.touches, dernier: r.dernier, ratees: r.ratees }).toEqual({ touches: 1, dernier: x.d, ratees: 3 });
  });
  it("la partie dure 30 s ; une touche après la cible ne compte plus", () => {
    const c = dailyCibles(J);
    expect(jouer(c, vif(c)).ticks).toBe(DUREE_TICKS);
    const x = c.cibles[0]!;
    expect(jouer(c, [{ tick: x.f, c: x.c }]).touches).toBe(0);
    expect(jouer(c, [{ tick: x.f - 1, c: x.c }]).touches).toBe(1);
  });
  it("classe les cibles touchées (↓) puis le tick de la dernière (↑), dans les colonnes de la fiche, et écrit son score", () => {
    expect(scoreDe({ touches: 17, dernier: 300 })).toEqual([17, 300]);
    expect(scoreParColonnes({ touches: 17, dernier: 300 })).toEqual({ touches: 17, dernier: 300 });
    expect(formatScore([17])).toBe(`17 / ${NB_CIBLES}`);
    const fiche = JSON.parse(readFileSync(new URL("../../../config/jeux/cibles.json", import.meta.url), "utf8")) as { classement: { colonnes: { nom: string; sens: string }[]; unite: string; format: string } };
    expect(fiche.classement.colonnes.slice(0, COLONNES_CLASSEMENT.length)).toEqual(COLONNES_CLASSEMENT);
    expect(fiche.classement.colonnes.slice(COLONNES_CLASSEMENT.length).map((k) => k.nom)).toEqual(["submitted_at", "player_id"]);
    expect({ unite: fiche.classement.unite, format: fiche.classement.format }).toEqual({ unite: "points", format: "entier" });
  });
  const c = dailyCibles(J);
  it("une partie vide finit avec zéro touche et le départage maximal", () => {
    const r = jouer(c, []);
    expect({ touches: r.touches, dernier: r.dernier, ratees: r.ratees }).toEqual({ touches: 0, dernier: DUREE_TICKS, ratees: 0 });
    expect(r.ticks).toBe(DUREE_TICKS);
  });
  it("un joueur vif touche tout, sans rien rater", () => {
    const r = jouer(c, vif(c));
    expect(r.touches).toBe(NB_CIBLES);
    expect(r.ratees).toBe(0);
  });
  it("la case sous un point du plateau", () => {
    expect(caseAuPoint(0, 0, 80, 60, LIGNES)).toBe(0);
    expect(caseAuPoint(79, 59, 80, 60, LIGNES)).toBe(COLONNES * LIGNES - 1);
    expect(caseAuPoint(80, 10, 80, 60, LIGNES)).toBe(-1);
  });
});

describe("la rediffusion", () => {
  const c = dailyCibles(J);
  it("fait l'aller-retour et rejoue au bit près", () => {
    const touches = vif(c);
    const code = enregistrer(c, touches);
    expect(decoderRediffusion(code).touches).toEqual(touches);
    expect(rejouer(c, code)).toEqual(jouer(c, touches));
  });
  it("refuse tout ce qui est illisible, avec un code", () => {
    const code = (r: Partial<Parameters<typeof encoderRediffusion>[0]>) => encoderRediffusion({ sim: 1, g: 1, contenu: { jour: J }, touches: [], ...r });
    const refus = (f: () => unknown) => {
      try {
        f();
      } catch (e) {
        return (e as { code?: string }).code;
      }
      return "aucun";
    };
    expect(refus(() => decoderRediffusion(""))).toBe("format_illisible");
    expect(refus(() => decoderRediffusion("***"))).toBe("format_illisible");
    expect(refus(() => decoderRediffusion("A".repeat(1500)))).toBe("trop_longue");
    expect(refus(() => decoderRediffusion(code({ sim: 2 })))).toBe("version_inconnue");
    expect(refus(() => decoderRediffusion(code({ g: 2 })))).toBe("version_inconnue");
    expect(refus(() => decoderRediffusion(code({ touches: [{ tick: DUREE_TICKS, c: 0 }] })))).toBe("format_illisible");
    expect(refus(() => decoderRediffusion(code({ touches: [{ tick: 3, c: NB_CASES }] })))).toBe("format_illisible");
    expect(refus(() => decoderRediffusion(code({ touches: Array.from({ length: MAX_TOUCHES + 1 }, () => ({ tick: 5, c: 1 })) })))).toBe("trop_longue");
    expect(refus(() => rejouer(c, code({ contenu: { jour: J + 1 } })))).toBe("contenu_different");
    expect(refus(() => rejouer(c, code({ contenu: { scenario: "essai" } })))).toBe("contenu_different");
  });
  it("une rediffusion de 200 touches tient dans la borne de texte", () => {
    const code = enregistrer(c, Array.from({ length: MAX_TOUCHES }, (_, i) => ({ tick: 300 + (i >> 3), c: (i * 7) % NB_CASES })));
    expect(code.length).toBeLessThanOrEqual(1000);
  });
});
